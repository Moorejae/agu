---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body class="bg-slate-950 text-slate-300 font-sans antialiased selection:bg-cyan-900 selection:text-cyan-50">
		<div class="max-w-4xl mx-auto px-6 py-12 md:py-20">
			<nav class="flex justify-between items-center mb-16 border-b border-slate-800 pb-6">
				<div class="text-xl font-bold text-slate-100 tracking-tight">AC.</div>
				<div class="space-x-6 text-sm font-medium">
					<a href="/agu/" class="hover:text-cyan-400 transition-colors">Profile</a>
					<a href="/agu/case-studies/cloudvoid" class="hover:text-cyan-400 transition-colors">CloudVoid</a>
				</div>
			</nav>
			<slot />
		</div>
	</body>
</html>